# The MCP server signs in as you with the same anon key the web app uses, so
# Supabase row-level security still applies — it can only ever see your rows.
#
# SUPABASE_URL / SUPABASE_ANON_KEY are read from the repo-root .env
# (VITE_SUPABASE_URL / VITE_SUPABASE_ANON_KEY) if not set here.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Your habit-tracker login.
HABIT_EMAIL=
HABIT_PASSWORD=
